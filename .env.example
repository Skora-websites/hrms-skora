[TEMPLATE]
# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Public site URL
NEXT_PUBLIC_SITE_URL=https://example.com

# SMTP (primary mail transport - any provider: Gmail/Workspace, Outlook, Zoho, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only for port 465 (implicit TLS); 587 uses STARTTLS
SMTP_SECURE=false
SMTP_USER=hr@yourcompany.com
SMTP_PASS=your-app-password
SMTP_FROM=HRMS <hr@yourcompany.com>

# Password reset email (Resend fallback)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=HRMS <noreply@example.com>

# One-time HRMS data seed endpoint. Set this only during an intentional seed operation, then rotate/remove it.
HRMS_SEED_KEY=replace-with-a-long-random-secret
