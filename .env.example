# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Public site URL
NEXT_PUBLIC_SITE_URL=https://example.com

# Password reset email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=HRMS <noreply@example.com>

# One-time HRMS data seed endpoint. Set this only during an intentional seed operation, then rotate/remove it.
HRMS_SEED_KEY=replace-with-a-long-random-secret
