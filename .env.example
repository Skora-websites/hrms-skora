# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Public site URL
NEXT_PUBLIC_SITE_URL=https://example.com

# Password reset email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=HRMS <noreply@example.com>

# One-time HRMS data seed endpoint. Set this only during an intentional seed operation, then rotate/remove it.
HRMS_SEED_KEY=replace-with-a-long-random-secret

# Authoritative email → role map for HRMS login routing (see lib/constants.ts).
# A single-line JSON object keyed by email. Kept out of git because it contains employee PII.
HRMS_ACCOUNT_ROLES_JSON={"hr@example.com":{"role":"hr_admin","displayName":"Jane Doe","firstName":"Jane","lastName":"Doe","department":"Human Resources","designation":"HR Manager","employeeCode":"HR-001"}}
